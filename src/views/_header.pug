include _mixins

header.header 
  .header__left
    .header__branding
      .header__logo
        img(src='/img/logo-white.png' alt='Natours logo')
      a.nav__el(href='/') All tours
    if(user)
      form.nav__search#search-form
        button.nav__search-btn
          svg 
            use(xlink:href='/img/icons.svg#icon-search')
        input#search-input.nav__search-input(type='text' placeholder='Search tours')
  button.header__menu-toggle#header-menu-toggle(type='button' aria-label='Toggle menu' aria-expanded='false')
    span
    span
    span
  nav.nav.nav--user#header-nav-links
    if user 
      button.nav__el.nav__el--logout#logout Log out
      a.nav__el(href='/me')
        +userPhoto(user.photo, 'nav__user-img', `Photo of ${user.name}`)
        span= user.name.split(' ')[0]
    else
      a.nav__el(href='/login') Log in
      a.nav__el.nav__el--cta(href='/signup') Sign up