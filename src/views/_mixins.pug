mixin userPhoto(photo, className, alt)
    if photo && photo.startsWith('http')
        img(class=className src=photo alt=alt)
    else
        img(class=className src=`/img/users/${photo}` alt=alt)

mixin profileNavItem(link,label,icon,active=false)
    li(class=`${active ? 'side-nav--active' : ''}`)
        a(href=link)
            svg
                use(xlink:href=`/img/icons.svg#icon-${icon}`)
            span.side-nav__label= label