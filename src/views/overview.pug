extends base

block content 
    main.main
        if tours.length === 0
            .overview__empty-state
                if isMyBookings
                    //- Case A: User has 0 booked tours
                    .overview__empty-icon-box
                        svg.overview__empty-icon
                            use(xlink:href='/img/icons.svg#icon-compass')
                    h2.heading-secondary You haven't booked any tours yet!
                    p.overview__empty-text Ready for your next big adventure? Browse our hand-crafted experiences and start exploring the world today.
                    a.btn.btn--green.btn--large(href='/') Discover New Tours

                else if isSearch
                    //- Case B: No results matching a search query
                    .overview__empty-icon-box
                        svg.overview__empty-icon
                            use(xlink:href='/img/icons.svg#icon-search')
                    h2.heading-secondary No tours matched your search
                    p.overview__empty-text We couldn't find anything matching "#{searchQuery}". Try checking your spelling or searching for a different destination.
                    a.btn.btn--green.btn--large(href='/') Clear Search

        else
            //- Display cards normally if array has elements
            .card-container
                each tour in tours
                    .card
                        .card__header
                            .card__picture
                                .card__picture-overlay &nbsp;
                                img.card__picture-img(src=`/img/tours/${tour.imageCover}` alt=`${tour.name}`)
                            h3.heading-tertirary
                                span= tour.name

                        .card__details
                            h4.card__sub-heading= `${tour.difficulty} ${tour.duration}-day tour`
                            p.card__text= tour.summary
                            .card__data
                                svg.card__icon
                                    use(xlink:href='/img/icons.svg#icon-map-pin')
                                span= tour.startLocation.description
                            .card__data
                                svg.card__icon
                                    use(xlink:href='/img/icons.svg#icon-calendar')
                                //- Handled a safe native fallback fallback checking case if startDates array is ever empty
                                span= tour.startDates && tour.startDates.length > 0 ? new Date(tour.startDates[0].date).toLocaleString('en-ng',{month:'long',year:'numeric'}) : 'Coming Soon'
                            .card__data
                                svg.card__icon
                                    use(xlink:href='/img/icons.svg#icon-flag')
                                span= `${tour.locations ? tour.locations.length : 0} stops`
                            .card__data
                                svg.card__icon
                                    use(xlink:href='/img/icons.svg#icon-user')
                                span= `${tour.maxGroupSize} people`

                        .card__footer
                            p
                                span.card__footer-value= `$${tour.price}`
                                | 
                                span.card__footer-text per person
                            p.card__ratings
                                span.card__footer-value= `${tour.ratingsAverage}`
                                | 
                                span.card__footer-text= `rating (${tour.ratingsQuantity})`
                            a.btn.btn--green.btn--small(href=`/tour/${tour.slug}`) Details
