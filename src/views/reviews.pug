extend base

include _mixins
include _myReviewCard

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +profileNavItem('/me','Settings','settings')
          +profileNavItem('/my-tours','My bookings','briefcase')
          +profileNavItem('/my-reviews','My reviews','star', true)
          +profileNavItem('/billing','Billing','credit-card')

      .user-view__content
        .user-view__form-container
          .reviews-dashboard
            .reviews-dashboard__header
              h1.heading-secondary My Reviews
              p.reviews-dashboard__subtitle Manage and view all the experiences you have shared with the Natours community.
            
            .reviews__container
              if !reviews || reviews.length === 0
                .reviews__empty-state
                  .reviews__empty-icon-box
                    svg.reviews__empty-icon
                      use(xlink:href='/img/icons.svg#icon-star')
                  h3.reviews__empty-title No Reviews Written Yet
                  p.reviews__empty-text You haven't shared your thoughts on any tours yet. Your feedback helps other travelers discover incredible experiences!
                  a.reviews__empty-btn(href='/my-tours') Review a Past Tour
              else
                .reviews__grid-layout
                  each review in reviews
                    +myReviewCard(review)
