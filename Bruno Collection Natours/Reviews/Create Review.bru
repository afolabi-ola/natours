meta {
  name: Create Review
  type: http
  seq: 1
}

post {
  url: {{URL}}api/v1/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "review":"Molestie non montes at fermentum cubilia quis dis placerat maecenas vulputate sapien facilisis",
    "tour":"5c88fa8cf4afda39709c2970",
    "rating":5
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
